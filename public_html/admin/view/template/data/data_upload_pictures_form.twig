{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-custom-field" data-toggle="tooltip" title="{{ button_save }}"
                        class="btn btn-primary">
                    <i class="fa fa-save"></i>
                </button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default">
                    <i class="fa fa-reply"></i>
                </a>
            </div>
            <h1>Добавяне на данни - Снимки</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        {% if error_warning %}
            <div class="alert alert-danger alert-dismissible">
                <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %}
        {% if success %}
            <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> Добавете файл и посочете колони за данни</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-custom-field"
                      class="form-horizontal">
                    <fieldset>
                        <div class="row">
                            <div class="form-group required col-sm-4">
                                <label class="col-sm-4 control-label">Баркод / Код</label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="text" name="data[barcode]" value="{{ barcode }}"
                                               placeholder="A" class="form-control"/>
                                        {% if error_barcode %}
                                            <div class="text-danger">{{ error_barcode }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-sm-4">
                                <label class="col-sm-4 control-label">От ред</label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="text" name="data[from_row]" value="{{ from_row }}"
                                               placeholder="3" class="form-control"/>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-sm-4">
                                <label class="col-sm-4 control-label">До ред</label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="text" name="data[to_row]" value="{{ to_row }}" placeholder=""
                                               class="form-control"/>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-sm-4 required">
                                <label class="col-sm-4 control-label">Снимки от колона</label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="text" name="data[picture]" value="{{ picture }}" placeholder="D"
                                               class="form-control"/>
                                        {% if error_picture %}
                                            <div class="text-danger">{{ error_picture }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-sm-4">
                                <label class="col-sm-4 control-label">Снимки до колона</label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="text" name="data[picture_to]" value="{{ picture_to }}"
                                               placeholder="F" class="form-control"/>
                                        {% if error_picture_to %}
                                            <div class="text-danger">{{ error_picture_to }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-sm-4">
                                <label class="col-sm-4 control-label">Име на снимка (колона)</label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="text" name="data[picture_name]" value="{{ picture_name }}"
                                               placeholder="C" class="form-control"/>
                                        {% if error_picture_name %}
                                            <div class="text-danger">{{ error_picture_name }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="form-group required col-sm-4">
                                <label class="col-sm-4 control-label">Файл с данни</label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="file" name="data_file" class="form-control"/>
                                        {% if error_data_file %}
                                            <div class="text-danger">{{ error_data_file }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-sm-4">
                                <label class="col-sm-4 control-label">Изтрий старите снимки</label>
                                <div class="col-sm-8">
                                    <input type="checkbox" name="data[delete_existing]" value="1" class="form-control"
                                           {% if delete_existing %}checked="checked"{% endif %}/>
                                </div>
                            </div>
                        </div>

                        <br/>
                        <p>* Ако полето <strong>"Снимки до колона"</strong> е празно ще вземе снимки само от колоната
                            посочена в <strong>"Снимки от колона"</strong></p>
                        <p>* Полето <strong>"Име на снимка (колона)"</strong> е по желание – ако е празно, ще се ползва
                            баркода за именуване.</p>
                    </fieldset>
                </form>

                {# Прогрес бар #}
                <div id="pictures-progress" class="well" style="display:none; margin-top:15px;">
                    <strong>Прогрес на обработката:</strong>
                    <div class="progress" style="margin-top:10px;">
                        <div id="pictures-progress-bar-inner" class="progress-bar" role="progressbar"
                             aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"
                             style="width: 0%;">
                            <span id="pictures-progress-text">0%</span>
                        </div>
                    </div>
                    <div id="pictures-progress-detail" style="margin-top:5px;">
                        Системата подготвя обработката...
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript"><!--
$(function () {
    var processing = false;
    var stopped = false;
    var convertUrl = '{{ convert_csv_url|replace({'&amp;':'&'}) }}';
    var processCsvUrl = '{{ process_csv_url|replace({'&amp;':'&'}) }}';

    function setProgress(percent, text, detail) {
        percent = Math.max(0, Math.min(100, percent));
        $('#pictures-progress').show();
        $('#pictures-progress-text').text(percent + '%');
        $('#pictures-progress-bar-inner').css('width', percent + '%').attr('aria-valuenow', percent);
        if (detail !== undefined) $('#pictures-progress-detail').text(detail);
    }

    function showError(error) {
        var html = '<div class="alert alert-danger alert-dismissible">';
        html += '<i class="fa fa-exclamation-circle"></i> Възникна грешка!';
        html += '<button type="button" class="close" data-dismiss="alert">&times;</button>';

        if (typeof error === 'object') {
            if (error.warning) html += '<div>' + error.warning + '</div>';
            if (error.barcode) html += '<div>' + error.barcode + '</div>';
            if (error.picture) html += '<div>' + error.picture + '</div>';
            if (error.data_file) html += '<div>' + error.data_file + '</div>';
        } else {
            html += '<div>' + error + '</div>';
        }

        html += '</div>';
        $('.container-fluid').first().prepend(html);
    }

    function showSuccess(message) {
        var html = '<div class="alert alert-success alert-dismissible">';
        html += '<i class="fa fa-check-circle"></i> ' + message;
        html += '<button type="button" class="close" data-dismiss="alert">&times;</button>';
        html += '</div>';
        $('.container-fluid').first().prepend(html);
    }

    $('#form-custom-field').on('submit', function (e) {
        e.preventDefault();
        if (processing) return false;

        stopped = false;
        processing = true;

        var form = this;
        var formData = new FormData(form);
        $('.alert').remove();

        setProgress(0, '0%', 'Качване на файл...');

        $.ajax({
            url: form.action,
            type: 'post',
            dataType: 'json',
            data: formData,
            cache: false,
            contentType: false,
            processData: false,

            xhr: function () {
                var xhr = new window.XMLHttpRequest();
                if (xhr.upload) {
                    xhr.upload.addEventListener('progress', function (e) {
                        if (e.lengthComputable) {
                            var p = Math.round((e.loaded / e.total) * 100);
                            setProgress(Math.min(p, 99), p + '%', 'Качване на файл... (' + formatBytes(e.loaded) + ' / ' + formatBytes(e.total) + ')');
                        }
                    }, false);
                }
                return xhr;
            },

            success: function (json) {
                if (json && json.error) {
                    processing = false;
                    showError(json.error);
                    return;
                }

                setProgress(100, '100%', 'Файлът е качен. Подготовка...');
                setTimeout(function () {
                    if (stopped) return;
                    setProgress(0, '0%', 'Конвертиране на файла...');
                    processConvert();
                }, 400);
            },

            error: function (xhr, status, error) {
                processing = false;
                showError('Грешка при качване: ' + (error || 'неизвестна грешка'));
            }
        });
    });

    function processConvert() {
        if (!processing) return;

        $.ajax({
            url: convertUrl,
            type: 'post',
            dataType: 'json',
            data: { batch_size: 300 },

            success: function(json) {
                if (json.error) {
                    processing = false;
                    showError(json.error);
                    return;
                }

                if (json.status === 'processing') {
                    $('#pictures-progress-detail').text(json.message || 'Конвертиране...');
                    processConvert();
                    return;
                }

                // Готово -> CSV обработка
                setProgress(0, '0%', 'Започва обработката на снимките...');
                processCsvChunk();
            },

            error: function(xhr, status, error) {
                processing = false;
                showError('Грешка при конвертиране: ' + (error || 'неизвестна'));
            }
        });
    }

    function processCsvChunk() {
        if (!processing) return;

        $.ajax({
            url: processCsvUrl,
            type: 'post',
            dataType: 'json',
            data: { batch_size: 20 },

            success: function(json) {
                if (json.error) {
                    processing = false;
                    showError(json.error);
                    return;
                }

                var percent = json.percentage || 0;

                $('#pictures-progress-text').text(percent + '%');
                $('#pictures-progress-bar-inner')
                    .css('width', percent + '%')
                    .attr('aria-valuenow', percent);

                var detail =
                    'Обработка: ' + (json.processed || 0) + ' / ' + (json.total || 0) +
                    ' | продукти: ' + (json.updated_products || 0) +
                    ' | снимки: ' + (json.updated_pictures || 0);

                $('#pictures-progress-detail').text(detail);

                if (json.status === 'done') {
                    processing = false;
                    showSuccess(json.message || 'Готово');
                    return;
                }

                processCsvChunk();
            },

            error: function(xhr, status, error) {
                processing = false;
                showError('Грешка при обработка: ' + (error || 'неизвестна'));
            }
        });
    }

    function formatBytes(bytes) {
        if (!bytes && bytes !== 0) return '';
        var sizes = ['B', 'KB', 'MB', 'GB'];
        var i = bytes === 0 ? 0 : Math.floor(Math.log(bytes) / Math.log(1024));
        var val = bytes / Math.pow(1024, i);
        return val.toFixed(val >= 10 || i === 0 ? 0 : 1) + ' ' + sizes[i];
    }
});
//--></script>

{{ footer }}
